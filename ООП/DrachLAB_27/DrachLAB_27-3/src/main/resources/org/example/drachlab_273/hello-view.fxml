<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300.0" prefWidth="450.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="org.example.drachlab_273.HelloController">
    <children>
        <DatePicker fx:id="datePicker" layoutX="50.0" layoutY="40.0" prefWidth="200.0" />
        <Button fx:id="checkButton" layoutX="50.0" layoutY="90.0" onAction="#onCheckClick" text="Визначити знаки" />

        <Label fx:id="slavicLabel" layoutX="50.0" layoutY="150.0" text="Слов'янський гороскоп: " />
        <Label fx:id="chineseLabel" layoutX="50.0" layoutY="190.0" text="Китайський гороскоп: " />
    </children>
</AnchorPane>