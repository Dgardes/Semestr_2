<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.drachlab_281.HelloController">
    <children>
        <MenuBar prefWidth="600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <menus>
                <Menu text="Розділи ООП">
                    <items>
                        <MenuItem onAction="#showEncapsulation" text="Інкапсуляція" />
                        <MenuItem onAction="#showInheritance" text="Наслідування" />
                        <MenuItem onAction="#showPolymorphism" text="Поліморфізм" />
                        <MenuItem onAction="#showAbstraction" text="Абстракція" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <TextArea fx:id="infoTextArea" editable="false" layoutX="20.0" layoutY="50.0" prefHeight="330.0" prefWidth="560.0" wrapText="true" />
    </children>
</AnchorPane>