<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="550.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.drachlab_292.InvoiceController">
    <children>
        <TableView fx:id="tableView" layoutX="20.0" layoutY="20.0" prefHeight="360.0" prefWidth="510.0">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="120.0" text="Назва" />
                <TableColumn fx:id="qtyCol" prefWidth="80.0" text="Кількість" />
                <TableColumn fx:id="priceCol" prefWidth="80.0" text="Ціна" />
                <TableColumn fx:id="packCol" prefWidth="100.0" text="Упаковка" />
                <TableColumn fx:id="totalCol" prefWidth="120.0" text="Сума" />
            </columns>
        </TableView>
    </children>
</AnchorPane>