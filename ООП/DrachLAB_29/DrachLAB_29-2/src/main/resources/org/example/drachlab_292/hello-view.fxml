<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="320.0" prefWidth="400.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.drachlab_292.InputController">
    <children>
        <Label layoutX="40.0" layoutY="30.0" text="Назва товару:" />
        <TextField fx:id="nameField" layoutX="160.0" layoutY="25.0" />

        <Label layoutX="40.0" layoutY="80.0" text="Кількість:" />
        <TextField fx:id="qtyField" layoutX="160.0" layoutY="75.0" />

        <Label layoutX="40.0" layoutY="130.0" text="Ціна:" />
        <TextField fx:id="priceField" layoutX="160.0" layoutY="125.0" />

        <Label layoutX="40.0" layoutY="180.0" text="Норма упаковки:" />
        <TextField fx:id="packField" layoutX="160.0" layoutY="175.0" />

        <Button layoutX="40.0" layoutY="240.0" onAction="#onAddProduct" text="Додати товар" />
        <Button layoutX="220.0" layoutY="240.0" onAction="#onShowInvoice" text="Накладна" />
        <Label fx:id="statusLabel" layoutX="40.0" layoutY="285.0" />
    </children>
</AnchorPane>