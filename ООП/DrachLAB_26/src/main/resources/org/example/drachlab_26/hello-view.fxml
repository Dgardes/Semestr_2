<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0"
            prefWidth="600.0"
            style="-fx-background-color: #E6F2FF;"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="org.example.drachlab_26.HelloController">
    <children>
        <Label fx:id="myLabel"
               layoutX="210.0"
               layoutY="120.0"
               text="Я люблю Java">
            <font>
                <Font name="Arial Bold" size="28.0" />
            </font>
        </Label>

        <Button fx:id="myButton"
                layoutX="225.0"
                layoutY="220.0"
                prefHeight="45.0"
                prefWidth="150.0"
                text="Натисни мене"
                onAction="#onButtonClick"
                style="-fx-background-color: #4CAF50; -fx-border-color: #388E3C; -fx-border-width: 2px; -fx-background-radius: 15px; -fx-border-radius: 15px; -fx-text-fill: white;">
            <font>
                <Font name="System" size="16.0" />
            </font>
        </Button>
    </children>
</AnchorPane>